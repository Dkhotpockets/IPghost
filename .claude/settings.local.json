      "Bash(go build ./pkg/netconfig)",
      "Bash(go test ./tests/security -run TestPrivilegeEnforcement -v)",
      "Bash(go build -o bin/gofakeip-client.exe ./cmd/gofakeip-client)",
      "Bash(bin/gofakeip-client.exe status)",
      "Bash(bin/gofakeip-client.exe setup --proxy 192.168.1.100:8080 --ports 80,443 --dry-run)",
      "Bash(curl -x http://127.0.0.1:8080 http://httpbin.org/user-agent -m 10)",
      "Bash(del pkgnetconfigprivileges_linux.go pkgnetconfigprivileges_darwin.go)",
      "Bash(go build -o bin/gofakeip-server-test.exe ./cmd/gofakeip-server)",
      "Bash(go test ./pkg/netconfig -v)"
