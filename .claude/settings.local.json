      "Bash(go test ./... -v)",
      "Bash(ipconfig)",
      "Bash(findstr /i \"IPv4\")",
      "Bash(powershell -Command \"Get-NetIPAddress -AddressFamily IPv4 | Select-Object -ExpandProperty IPAddress\")",
      "Bash(bin/gofakeip-server.exe -listen 127.0.0.1:8080 -bind-ip 127.0.0.1 -protocols http -log-level info)",
