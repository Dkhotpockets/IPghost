      "Bash(powershell -Command \"Test-NetConnection -ComputerName 127.0.0.1 -Port 8080\")",
      "Bash(bin/gofakeip-server.exe -listen 0.0.0.0:8080 -bind-ip 192.168.1.252 -protocols http -log-level info)",
